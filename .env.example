# Public app URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server only. Never expose this value to browser code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Razorpay: Account & Settings -> API Keys (test values for development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Server only
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard -> Webhooks -> webhook secret. Server only.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Server only. Vercel uses this to authorize the scheduled /api/cron/seo-health call.
CRON_SECRET=replace_with_a_long_random_value

# Optional local SQLite location. Leave unset to use the default development path.
# SQLITE_DB_PATH=
